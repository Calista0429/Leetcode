   "source": [
    "from collections import Counter\n",
    "if len(nums1) > len(nums2):\n",
    "    nums2 , nums1 = nums1, nums2\n",
    "count1 = Counter(nums1)\n",
    "res = []\n",
    "for num in nums2:\n",
    "    if count1[num] > 0:\n",
    "        res.append(num)\n",
    "        count1[num] -= 1\n"
   ]
